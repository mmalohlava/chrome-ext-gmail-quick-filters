{
  "manifest_version": 3,
  "name": "Gmail Quick Filters",
  "description": "Quick Today/Yesterday/Snoozed search filters, date highlighting and sender cues for Gmail.",
  "version": "1.0",
  "action": {
    "default_icon": {
      "16": "icon.png"
    },
    "default_title": "Gmail Quick Filters"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "js/content_script.js"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ]
}
